# AEGIS configuration reference. PLACEHOLDERS ONLY: never put real values here.
# For local development, `scripts/dev-setup.sh` generates a working .env.
# In staging/production, inject these from your secret manager; do not use files.

# --- Required ---------------------------------------------------------------
# development | test | staging | production
AEGIS_ENV=development
# Exact browser origin of the application (scheme://host[:port]); https outside development.
APP_ORIGIN=http://localhost:5173
# Runtime role (member of aegis_app; NOT the schema owner). Production requires sslmode=verify-full.
DATABASE_URL=postgres://<app_login>:<password>@<host>:5432/<database>

# --- Migrations only (do not give this to the API process) -----------------
DATABASE_MIGRATION_URL=postgres://<owner_role>:<password>@<host>:5432/<database>

# --- HTTP -------------------------------------------------------------------
HOST=127.0.0.1
PORT=3000
# Set true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=20
BODY_LIMIT_BYTES=65536
# Serve the built web app from the API process (single origin).
# WEB_DIST_DIR=/srv/aegis/web

# --- Sessions and authentication ---------------------------------------------
# Must be true outside development (enables Secure + __Host- cookie).
SESSION_COOKIE_SECURE=true
SESSION_ABSOLUTE_TTL_MINUTES=720
SESSION_IDLE_TTL_MINUTES=30
REAUTH_WINDOW_MINUTES=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# --- Database tuning ----------------------------------------------------------
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# --- Logging ------------------------------------------------------------------
# debug/trace are rejected outside development.
LOG_LEVEL=info

# --- Background worker --------------------------------------------------------
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=1000

# --- Integrations -------------------------------------------------------------
# All three must be false outside development (startup fails otherwise).
INTEGRATION_ALLOW_PRIVATE_NETWORK=false
INTEGRATION_ALLOW_INSECURE_HTTP=false
INTEGRATION_TEST_ADAPTER_ENABLED=false
HEALTH_STALE_AFTER_MINUTES=30
# Integration credentials are referenced as env:AEGIS_SECRET_<NAME>. Only this
# namespace can be referenced; values are never stored or returned by the API.
# AEGIS_SECRET_EXAMPLE_TOKEN=<injected by secret manager>
